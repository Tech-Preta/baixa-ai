# Origem do site. Separe várias com vírgula.
CORS_ORIGINS=http://localhost:3000

# Segredo dos links de download. Obrigatório quando APP_ENV=production.
DOWNLOAD_TOKEN_SECRET=troque-este-valor

APP_ENV=development
TRUST_PROXY=true

# Limites
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=600
EXTRACT_TIMEOUT_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=120
MAX_FILE_BYTES=104857600
TOKEN_TTL_SECONDS=600

# Opcional. O SDK só inicia se esta variável existir.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
